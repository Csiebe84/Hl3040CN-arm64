# --- Python ---
.venv312/
.venv/
*.pyc
__pycache__/
*.egg-info/

# --- Cython build artefacts (regenerated by build_cython.sh) ---
hl3040cn/src/*.c
hl3040cn/src/*.so
hl3040cn/build/

# --- Brother proprietary blobs: NOT redistributed ---
# lut/ and color_data/ hold Brother's calibration tables (colour grids,
# BRCD dither tables). They ship inside Brother's LPR driver and are
# extracted locally by scripts/extract_blobs.sh, so each user keeps them
# under Brother's own licence (interoperability, EU 2009/24/EC Art. 6).
# The same approach as the upstream hl4150 project.
hl3040cn/src/lut/
hl3040cn/src/color_data/
hl3040cn/lut/
hl3040cn/color_data/
.brother-blobs/

# ref/ holds Brother's proprietary i386 filters and PPDs, used only to
# re-derive the tables. Never commit this directory.
ref/

# --- Local run output ---
logs/
samples/
*.xl2hb
*.ppm

# --- Agent scratch files ---
.color_agent_id
.delegated_agents
prompts/

# --- Local pre-change backups (kept on disk, not in history) ---
backup-*/
*.vor-*

# --- Rust build artefacts ---
hl3040cn/rust/target/
