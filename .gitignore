# Brother calibration tables. These ship inside Brother's own LPR driver and
# remain under Brother's licence; they are extracted locally by
# hl3040cn/src/extract_blobs.py and must never be redistributed here.
hl3040cn/src/color_data/
hl3040cn/src/lut/
hl3040cn/lut/
hl3040cn/color_data/

# The original Brother filter binary used to extract the tables from.
ref/*.bin
ref/**/*.bin

# Reference material: Brother's LPR package, the 4150 driver used as a porting
# reference, captured printer sessions. Third-party or proprietary, not ours.
ref/

# Cython build products; the .pyx files are the source of truth.
hl3040cn/src/_*_fast.c
hl3040cn/src/_*_fast*.so

# Precomputed inverse colour LUTs (64 MiB each, rebuilt by install.sh).
*.npy

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Build and scratch
build/
dist/
.brother-blobs/
logs/*.log
*.prn

# Local working notes and the handover brief for the colour investigation.
# Kept out of the repository because they describe the local machine.
HANDOVER.md
NOTES.md

# Local agent session id and the helper that drives it; both name this host.
.color_agent_id
tools/launch_agent.py

# Host-specific scratch tooling for the colour investigation, not part of
# the driver itself.
tools/__pycache__/
